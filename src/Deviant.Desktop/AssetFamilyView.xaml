<UserControl x:Class="Deviant.Desktop.AssetFamilyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource WindowForeground}">
 <Grid Margin="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="FamilyName" Text="Assets" FontSize="20" FontWeight="SemiBold"/><ComboBox x:Name="Groups" DisplayMemberPath="Label" Visibility="Collapsed" Margin="0,8,0,0" SelectionChanged="GroupChanged" AutomationProperties.Name="Asset group"/><Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBox x:Name="Search" TextChanged="FiltersChanged" AutomationProperties.Name="Search assets"/><ComboBox x:Name="Sort" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="SortChanged" AutomationProperties.Name="Sort assets"/></Grid></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><TextBlock x:Name="Page" Margin="0,0,0,6"/><WrapPanel><Button x:Name="Previous" Content="Previous" Click="Previous_Click" IsEnabled="False"/><Button x:Name="Next" Content="Next" Click="Next_Click" IsEnabled="False"/></WrapPanel></StackPanel>
   <DataGrid x:Name="Rows" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="SelectionChanged" EnableRowVirtualization="True" CanUserSortColumns="False"><DataGrid.Columns><DataGridTemplateColumn Header="Name" Width="300" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image x:Name="NativeThumbnail" Width="48" Height="48" Margin="0,3,8,3" Stretch="Uniform" Loaded="NativeThumbnail_Loaded" DataContextChanged="NativeThumbnail_ContextChanged"/><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Bytes" Binding="{Binding SizeLabel}" Width="140" MinWidth="120"/></DataGrid.Columns></DataGrid>
  </DockPanel>
  <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Resize results and details"/>
  <DockPanel Grid.Column="2">
   <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="SelectedName" Text="Select an asset" FontSize="20" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,12"><Button x:Name="ExportOriginal" Content="Export original" Click="Export_Click" IsEnabled="False"/><TextBlock x:Name="PreviewStatus" Text="Preview unavailable" Visibility="Collapsed" VerticalAlignment="Center" Margin="10,0"/><Button Content="Cancel" Click="Cancel_Click"/></WrapPanel></StackPanel>
   <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap"/>
   <StackPanel DockPanel.Dock="Bottom"><Expander x:Name="RelatedPanel" Header="Related" IsExpanded="True" Visibility="Collapsed"><StackPanel><TextBlock x:Name="RelatedStatus" Margin="0,4,0,6"/><ListView x:Name="RelatedRows" MaxHeight="180" MouseDoubleClick="Related_DoubleClick" PreviewKeyDown="Related_KeyDown" AutomationProperties.Name="Related catalogs"><ListView.View><GridView><GridView.ColumnHeaderContainerStyle><Style TargetType="{x:Type GridViewColumnHeader}"><Setter Property="Visibility" Value="Collapsed"/></Style></GridView.ColumnHeaderContainerStyle><GridViewColumn Width="150" DisplayMemberBinding="{Binding Label}"/><GridViewColumn Width="180" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View></ListView><Button x:Name="OpenRelated" Content="Open catalog" HorizontalAlignment="Left" Margin="0,6,0,8" IsEnabled="{Binding SelectedItem.CanNavigate,ElementName=RelatedRows,FallbackValue=False}" Click="OpenRelated_Click"/></StackPanel></Expander><Expander Header="Advanced" IsExpanded="False"><StackPanel><Grid Margin="0,6,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="TypeFilter" Grid.Column="1" TextChanged="FiltersChanged" AutomationProperties.Name="Resource type"/><TextBlock Text="ID" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0"/><TextBox x:Name="IdFilter" Grid.Column="3" TextChanged="FiltersChanged" AutomationProperties.Name="Resource ID"/></Grid><TextBox x:Name="Advanced" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="420"/><TextBox x:Name="RelatedEvidence" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="200"/></StackPanel></Expander></StackPanel><ContentControl x:Name="NativeImageHost" Visibility="Collapsed"/>
  </DockPanel>
 </Grid>
</UserControl>
