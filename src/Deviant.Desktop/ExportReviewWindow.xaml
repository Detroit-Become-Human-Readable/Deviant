<Window x:Class="Deviant.Desktop.ExportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review export" Width="560" SizeToContent="Height" MinWidth="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Export" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="Resources" FontWeight="SemiBold" /><TextBlock Text="{Binding ResourceCount}" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Bytes" FontWeight="SemiBold" /><TextBlock Text="{Binding Bytes}" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Invalid" FontWeight="SemiBold" /><TextBlock Text="{Binding InvalidCount}" /></StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="Export folder" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="6,0,0,0" />
            <TextBox x:Name="OutputFolderTextBox" MinWidth="360" />
        </DockPanel>
        <CheckBox Grid.Row="4" x:Name="OverwriteCheckBox" Content="Replace existing files" Margin="0,0,0,12" />
        <DockPanel Grid.Row="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Export" IsDefault="True" Click="Export_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
