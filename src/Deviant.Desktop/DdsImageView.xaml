<UserControl x:Class="Deviant.Desktop.DdsImageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Deviant.Desktop" Foreground="{DynamicResource WindowForeground}">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top"><WrapPanel><Button x:Name="OpenDds" Content="Open DDS" Click="Open_Click"/><Button x:Name="ExportDds" Content="Export DDS" Click="ExportDds_Click" IsEnabled="False"/><Button x:Name="ExportPng" Content="Export PNG" ToolTip="Full image with the selected exposure and tone map" Click="ExportPng_Click" IsEnabled="False"/><ComboBox x:Name="Layers" Width="95" Margin="10,0,0,0" Visibility="Collapsed" SelectionChanged="SubresourceChanged"/><ComboBox x:Name="Faces" Width="100" Margin="5,0,0,0" Visibility="Collapsed" SelectionChanged="SubresourceChanged"/><ComboBox x:Name="Mips" Width="120" Margin="10,0" SelectionChanged="MipChanged"/><TextBlock Text="View" VerticalAlignment="Center" Margin="4,0"/><ComboBox x:Name="Channels" Width="95" SelectionChanged="ChannelChanged"/><TextBlock Text="Zoom" VerticalAlignment="Center" Margin="12,0,4,0"/><Slider x:Name="Zoom" Width="130" Minimum="0.1" Maximum="4" Value="1" ValueChanged="ZoomChanged"/></WrapPanel>
   <StackPanel x:Name="HdrControls" Orientation="Horizontal" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock Text="Exposure" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="Exposure" Minimum="-8" Maximum="8" Value="0" Width="160" ValueChanged="HdrChanged"/><ComboBox x:Name="ToneMap" Width="110" Margin="12,0" SelectionChanged="ToneMapChanged"/></StackPanel>
   <TextBlock x:Name="ImageName" FontWeight="SemiBold" FontSize="18" Margin="0,12,0,3"/><TextBlock x:Name="Metadata" Margin="0,0,0,10"/></StackPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><local:ProcessingAnimation x:Name="ImageProcessing" DockPanel.Dock="Left" Margin="0,0,8,0"/><TextBlock x:Name="Status" Text="Open a DDS image to inspect its mips and channels." VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
  <Grid><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#343434"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#484848"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,8,8"/><RectangleGeometry Rect="8,8,8,8"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="Preview" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"><Image.LayoutTransform><ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/></Image.LayoutTransform></Image></ScrollViewer>
  </Grid>
 </DockPanel>
</UserControl>
