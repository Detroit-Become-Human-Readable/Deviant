<UserControl x:Class="Deviant.Desktop.AnimationPlaybackView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <WrapPanel Margin="0,0,0,6">
   <Button x:Name="PlayButton" Content="Play" Click="PlayClicked" IsEnabled="False" />
   <CheckBox x:Name="LoopToggle" Content="Loop" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" Checked="OptionsChanged" Unchecked="OptionsChanged" />
   <CheckBox x:Name="InPlaceToggle" Content="In place" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" Checked="OptionsChanged" Unchecked="OptionsChanged" />
   <ComboBox x:Name="SpeedSelect" Width="65" Margin="12,0,0,0" SelectionChanged="SpeedChanged" SelectedIndex="2">
    <ComboBoxItem Content="0.25×" Tag="0.25"/><ComboBoxItem Content="0.5×" Tag="0.5"/><ComboBoxItem Content="1×" Tag="1"/><ComboBoxItem Content="2×" Tag="2"/>
   </ComboBox>
  </WrapPanel>
  <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" ValueChanged="PositionChanged" IsEnabled="False" AutomationProperties.Name="Animation position" />
  <TextBlock x:Name="TimeText" Text="0:00 / 0:00" HorizontalAlignment="Right" Margin="0,3,0,0" />
 </StackPanel>
</UserControl>
