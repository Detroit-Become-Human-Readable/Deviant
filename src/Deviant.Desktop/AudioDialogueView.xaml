<UserControl x:Class="Deviant.Desktop.AudioDialogueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220" Foreground="{DynamicResource WindowForeground}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="Status" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Language" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="Languages" DisplayMemberPath="Label" MinWidth="72" MaxWidth="120" Height="28"
                      SelectionChanged="LanguageChanged" AutomationProperties.Name="Filter dialogue language" />
        </DockPanel>

        <Grid Grid.Row="2">
            <ListView x:Name="Occurrences" SelectionChanged="OccurrenceSelected"
                      AutomationProperties.Name="Dialogue occurrences"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="5,4" Margin="0,0,0,3" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" TextElement.FontSize="11" Opacity="0.76">
                                    <TextBlock Text="{Binding TextOccurrence.Language}" />
                                </StackPanel>
                                <TextBlock Text="{Binding TextOccurrence.Text}" TextWrapping="Wrap"
                                           ToolTip="{Binding TextOccurrence.Text}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyMessage" Text="No dialogue linked."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="12"
                       IsHitTestVisible="False" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="True">
                <Button x:Name="OpenText" DockPanel.Dock="Right" Content="Open text"
                        IsEnabled="False" Click="OpenTextClicked" />
                <TextBlock x:Name="SelectedLanguage" Text="Select dialogue"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBox x:Name="SelectedText" Grid.Row="1" Margin="0,4,0,0" IsReadOnly="True"
                     MinHeight="32" MaxHeight="76" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0"
                     Background="Transparent" VerticalContentAlignment="Top" />
        </Grid>

        <Expander x:Name="AdvancedPanel" Grid.Row="4" Header="Advanced" Margin="0,5,0,0">
            <ScrollViewer x:Name="AdvancedScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="Advanced" IsReadOnly="True" FontFamily="Consolas" FontSize="10"
                         TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                         VerticalScrollBarVisibility="Disabled" />
            </ScrollViewer>
        </Expander>
    </Grid>
</UserControl>
