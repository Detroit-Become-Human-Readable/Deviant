<UserControl x:Class="Deviant.Desktop.TextureExplorerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource WindowForeground}">
 <UserControl.Resources>
  <DataTemplate x:Key="TextureCard">
   <StackPanel Width="164" Margin="5">
    <Border Height="132" Background="{DynamicResource SurfaceAlternateBackground}" CornerRadius="4"><Grid>
     <TextBlock Text="No preview" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=NativeThumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <Image x:Name="NativeThumbnail" Margin="6" Stretch="Uniform" Loaded="Thumbnail_Loaded" DataContextChanged="Thumbnail_ContextChanged"/>
    </Grid></Border>
    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,6,0,2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" ToolTip="{Binding SourceTooltip}"/>
    <TextBlock Text="{Binding RecoveredName}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceTooltip}"/>
    <TextBlock Text="{Binding SizeFormat}" FontSize="11" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding Context}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="45" ToolTip="{Binding ContextTooltip}" Margin="0,2,0,0"/>
    <TextBlock Text="{Binding Inferred}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="RelationshipRow"><StackPanel Margin="4"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Role}" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate>
 </UserControl.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top">
   <DockPanel Margin="0,0,0,10"><TextBlock Text="Textures" FontSize="22" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Cancel" HorizontalAlignment="Right" Click="Cancel_Click"/></DockPanel>
   <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="Search" Grid.Column="1" TextChanged="SearchChanged" ToolTip="Name, path, owner, alias or ID"/><Button Grid.Column="2" Content="Reset" Click="Reset_Click"/></Grid>
   <WrapPanel Margin="0,0,0,12">
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Dimensions" Margin="0,0,0,3"/><ComboBox x:Name="Dimensions" MinWidth="120" SelectionChanged="FilterChanged"/></StackPanel>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Format" Margin="0,0,0,3"/><ComboBox x:Name="Formats" MinWidth="110" SelectionChanged="FilterChanged"/></StackPanel>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Role" Margin="0,0,0,3"/><ComboBox x:Name="Roles" MinWidth="120" SelectionChanged="FilterChanged"/></StackPanel>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Relationships" Margin="0,0,0,3"/><ComboBox x:Name="Relationships" MinWidth="145" SelectionChanged="FilterChanged"/></StackPanel>
    <StackPanel x:Name="ContextFilter" Margin="0,0,10,0" Visibility="Collapsed"><TextBlock Text="Used by" Margin="0,0,0,3"/><ComboBox x:Name="Contexts" DisplayMemberPath="Label" MinWidth="150" MaxWidth="300" SelectionChanged="FilterChanged"/></StackPanel>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Sort" Margin="0,0,0,3"/><ComboBox x:Name="Sort" MinWidth="120" SelectionChanged="FilterChanged"/></StackPanel>
   </WrapPanel>
  </StackPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Previous" Content="Previous" Click="Previous_Click"/><TextBlock x:Name="Page" VerticalAlignment="Center" Margin="8,0"/><Button x:Name="Next" Content="Next" Click="Next_Click"/></StackPanel><TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="280"/></Grid.ColumnDefinitions>
   <Grid><ListBox x:Name="Rows" ItemTemplate="{StaticResource TextureCard}" SelectionChanged="Rows_SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox><TextBlock x:Name="Empty" Text="No matching textures" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="{DynamicResource ControlBorder}"/>
   <DockPanel Grid.Column="2" Margin="10,0,0,0">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock x:Name="SelectedName" Text="Select a texture" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap"/><TextBlock x:Name="SelectedSummary" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SelectedInferred" Text="Inferred" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/></StackPanel>
    <TabControl x:Name="DetailTabs">
     <TabItem Header="Preview"><Grid Margin="8"><ContentControl x:Name="ImageHost" Visibility="Collapsed"/><TextBlock x:Name="PreviewStatus" Text="Select a texture" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></TabItem>
     <TabItem Header="Used by"><DockPanel Margin="8"><Button DockPanel.Dock="Bottom" Content="Open" Click="OpenOwner_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/><TextBlock x:Name="OwnerStatus" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"/><ListBox x:Name="OwnerRows" ItemTemplate="{StaticResource RelationshipRow}" MouseDoubleClick="Owner_DoubleClick" KeyDown="Owner_KeyDown"/></DockPanel></TabItem>
     <TabItem Header="Related"><DockPanel Margin="8"><Button DockPanel.Dock="Bottom" Content="Open" Click="OpenRelated_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/><TextBlock x:Name="RelatedStatus" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"/><ListBox x:Name="RelatedRows" ItemTemplate="{StaticResource RelationshipRow}" MouseDoubleClick="Related_DoubleClick" KeyDown="Related_KeyDown"/></DockPanel></TabItem>
     <TabItem Header="Details"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
      <TextBlock Text="Alias" FontWeight="SemiBold"/><TextBox x:Name="Alias" MaxLength="512" Margin="0,5,0,8"/><WrapPanel><Button x:Name="SaveAlias" Content="Save" Click="SaveAlias_Click"/><Button x:Name="ClearAlias" Content="Clear" Click="ClearAlias_Click"/><TextBlock x:Name="AliasStatus" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap"/></WrapPanel>
      <TextBlock x:Name="Names" TextWrapping="Wrap" Margin="0,18,0,0"/>
      <TextBlock Text="Provenance" FontWeight="SemiBold" Margin="0,18,0,5"/><TextBlock x:Name="Provenance" TextWrapping="Wrap"/>
      <StackPanel x:Name="ConflictPanel" Visibility="Collapsed"><TextBlock Text="Conflicts" FontWeight="SemiBold" Margin="0,18,0,5"/><TextBlock x:Name="Conflicts" TextWrapping="Wrap"/></StackPanel>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Advanced"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><StackPanel x:Name="CatalogFilter" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="Catalog" Margin="0,0,0,4"/><ComboBox x:Name="Catalogs" DisplayMemberPath="Label" SelectionChanged="FilterChanged"/></StackPanel><Button x:Name="ExportOriginal" Content="Export original" Click="ExportOriginal_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,0,0,10"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><TextBlock x:Name="Advanced" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/></ScrollViewer></DockPanel></TabItem>
    </TabControl>
   </DockPanel>
  </Grid>
 </DockPanel>
</UserControl>
